  "cards": [
    {
      "dot": "emerald",
      "title": "泳道就是架构",
      "items": [
        "最上面一条对照泳道：传统设计，凭据和检查都在进程内",
        "下面四条是 Muse：用户 / Runtime cell / Host domain / 外部世界",
        "cell 是预期会被攻破的不可信域，host 是它够不着的控制面",
        "两条域之间只有一条通道：Unix socket + SO_PEERCRED"
      ]
    },
    {
      "dot": "rose",
      "title": "列就是流程，6 个阶段装下 15 步",
      "items": [
        "① 任务进入 ② 推理与提议 ③ 三道独立判断 ④ 出口 ⑤ 回注",
        "阶段内部的多步被合并成一列内的节点与边",
        "对照泳道只走 3 列就到外部服务，Muse 要走完 5 列",
        "流程变长不是缺点 —— 每一列都是一道别人要过的关"
      ]
    },
    {
      "dot": "cyan",
      "title": "三个技术细节留在图上",
      "items": [
        "CLI → privsep：typed args + file descriptor，不是路径字符串",
        "privsep → authd：按 cgroup 身份申请，改请求参数没有用",
        "Sentinel → 审批界面：直达客户端，不经过模型上下文",
        "出口检查：L4/L7 看 hostname、解析后与最终 IP、端口、协议、方法、路径"
      ]
    }
  ]
