  "cards": [
    {
      "dot": "rose",
      "title": "传统：一个域，全都在一起",
      "items": [
        "agent、工具、凭据、检查跑在同一个进程",
        "权限检查是可被绕过的代码，不是结构性边界",
        "凭据是环境变量，agent 读得到",
        "出网没有中介，检查与执行共用一个地址空间"
      ]
    },
    {
      "dot": "emerald",
      "title": "Muse：两个域，一条窄通道",
      "items": [
        "Runtime cell 跑 agent，被当成不可信区",
        "Host domain 放裁决、凭据、特权代码",
        "两个域只通过 Unix socket + SO_PEERCRED 通信",
        "凭据只在出口替换，agent 全程看不到真值"
      ]
    },
    {
      "dot": "cyan",
      "title": "控制面里还有什么（图中未展开）",
      "items": [
        "hatch-safety：独立分类器，检查进出模型的请求与响应",
        "Postgres：持久状态，与 cell 和凭据库分开",
        "推理与遥测代理：通往外部基础设施的受限路径",
        "cell 另有独立根文件系统、seccomp 过滤、受限 capabilities"
      ]
    }
  ]
