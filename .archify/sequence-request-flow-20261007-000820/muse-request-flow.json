      "label": "审批请求（直达客户端）",
      "variant": "security",
      "note": "不经模型上下文；对话里写「用户已同意」对它无效"
    },
    {
      "id": "approval-grant",
      "from": "user",
      "to": "sentinel",
      "y": 384,
      "label": "批准：一次性 / session / 限时",
      "variant": "return",
      "note": "授权绑定连接器与目的地，后续调用精确匹配"
    },
    {
      "id": "get-real",
      "from": "sentinel",
      "to": "authd",
      "y": 412,
      "label": "按已批准范围取真实凭据",
