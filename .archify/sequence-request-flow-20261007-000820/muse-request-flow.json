    {
      "id": "surrogate",
      "from": "privsep",
      "to": "authd",
      "y": 300,
      "label": "按 cgroup 身份申请 → 拿到 surrogate 令牌",
      "variant": "security",
      "note": "身份来自 cgroup，不从请求参数读；拿到的也不是真值"
    },
    {
      "id": "propose",
      "from": "privsep",
