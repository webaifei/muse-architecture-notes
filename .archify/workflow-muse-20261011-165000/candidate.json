  "cards": [
    {
      "dot": "cyan",
      "title": "这张泳道图的中心逻辑",
      "items": [
        "Muse 只能「提议」，只有 Sentinel 能「授权」——动作链上没有任何一步能绕过它",
        "两条链分开管：推理内容由 hatch-safety 独立送检（请求与响应都检查），工具动作与网络出口由 Sentinel 管",
        "真凭证不进 agent 上下文：authd 只发代理令牌，真实凭证由 Sentinel 在网络边界替换"
      ]
    },
    {
      "dot": "rose",
      "title": "三条链路，各自独立",
      "items": [
        "推理链：harness → 推理代理 → 模型；代理把请求与响应都旁路给 hatch-safety",
        "动作链：harness → 工具 → Sentinel 判决 → 授权状态 → privsep → 外部服务",
        "凭证链：Sentinel 决定能拿什么 → authd 供给 → privsep 按 cgroup 白名单执行"
      ]
    },
    {
      "dot": "violet",
      "title": "人在回路",
      "items": [
        "判定 ask 时执行暂停，弹窗直接来自客户端 UI，不经过与 Muse 的对话",
        "批准是 capability：绑定连接器/目的地/用例，支持一次性、会话级、任务级、限时、永久",
        "答复写回 Sentinel 的权威授权状态后才放行，后续调用必须精确匹配已授权范围"
      ]
    },
    {
      "dot": "amber",
      "title": "运行位置与边界",
      "items": [
        "第 2 泳道整条都在 systemd-nspawn runtime cell 内：harness、工具、浏览器；cell root 映射为非特权宿主用户",
        "第 3、4 泳道在 cell 之外的宿主侧：推理代理、hatch-safety、Sentinel、authd、privsep，agent 无法覆盖",
        "deny 直接拒绝；读过用户数据的「污点」进程失去自动放行；CDP broker 也在 cell 外，子智能体只看无障碍树"
      ]
    }
  ]
